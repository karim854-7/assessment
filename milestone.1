class student:
    def __init__(self,name,id,grade):
       self.name = name
       self.id = id
       self.grade = grade

    def display_info(self):
        print("student name:",self.name)
        print("student id",self.id)
        print("student grade",self.grade)

 student1 = student("karim", 2500781, 100)
 student1.display_info()